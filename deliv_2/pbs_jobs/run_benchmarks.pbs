#!/bin/bash
#PBS -N benchmarks
#PBS -o ./benchmarks.out
#PBS -e ./benchmarks.err
#PBS -q short_cpuQ
#PBS -l walltime=6:00:00
#PBS -l select=1:ncpus=24:mem=16gb

# Load modules
module load gcc91
module load valgrind-3.15.0
# Navigate to project root directory
echo "Starting directory: $(pwd)"
echo "Directory contents:"
ls -la

# Find project root (handles submission from anywhere)
if [ -d "src" ]; then
    echo "Found src/ - already in project root"
elif [ -d "../src" ]; then
    cd ..
    echo "Moved up one directory to: $(pwd)"
elif [ -d "PARCO-Computing-2026-244967/src" ]; then
    cd PARCO-Computing-2026-244967
    echo "Changed to project directory: $(pwd)"
elif [ -d "$HOME/PARCO-Computing-2026-244967/src" ]; then
    cd "$HOME/PARCO-Computing-2026-244967"
    echo "Changed to home project directory: $(pwd)"
elif [ -d "pbs_jobs" ]; then
    echo "In pbs_jobs/ directory, moving up"
    cd ..
    if [ ! -d "src" ]; then
        echo "ERROR: Moved up but still no src/ found!"
        echo "Current location: $(pwd)"
        ls -la
        exit 1
    fi
else
    echo "ERROR: Cannot find project directory!"
    echo "Current location: $(pwd)"
    ls -la
    exit 1
fi

echo "Project root: $(pwd)"
echo "Verifying src/ directory exists:"
ls -la src/

# Clean and recompile the project (to ensure correct GLIBC version)
echo "Cleaning old build artifacts..."
rm -f bench_*.o executable test_config

echo "Compiling main executable..."
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/main.c -o main.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/generator.c -o generator.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/m_to_csr.c -o m_to_csr.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -o executable main.o generator.o m_to_csr.o -lm
echo "Main executable compiled"
ls -lh executable

# Compile test configurations
echo "Compiling test_config..."
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/test_configurations.c -o test_configurations.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -o test_config test_configurations.o generator.o m_to_csr.o -lm
echo "Test config compiled"
ls -lh test_config

echo "=== Starting Cache Benchmark ==="
bash scripts/bench_cache.sh

echo "=== Starting Configurations Benchmark ==="
bash scripts/bench_configurations.sh

echo "=== Starting Matrices Benchmark ==="
bash scripts/bench_matrices.sh

echo "=== All benchmarks completed ==="
