#!/bin/bash
#PBS -N weak_scaling_sweep
#PBS -l select=8:ncpus=32:mpiprocs=16:ompthreads=2:mem=64gb
#PBS -l walltime=06:00:00
#PBS -q short_cpuQ
#PBS -o weak_scaling_sweep.out
#PBS -e weak_scaling_sweep.err
#PBS -m abe

#
# PBS Job: Weak Scaling Benchmark for SpMV
#
# Resources requested:
#   - 8 nodes with 64 cores each (512 cores total, no hyperthreading)
#   - 16 MPI processes per node max (128 total)
#   - 2 OpenMP threads per MPI process
#   - 64GB memory per node
#
# Weak Scaling Strategy (CORRECTED):
#   - Keep NNZ per process CONSTANT (true weak scaling)
#   - Rows per process fixed, density decreases as P increases
#   - Total matrix size scales with process count
#   - Ideal: constant execution time as P increases
#
# Matrix sizes (with rows_per_proc=200k, nnz_per_proc=40M):
#   2 procs:    400k×400k matrix,  80M total NNZ, density~0.050%
#   4 procs:    800k×800k matrix, 160M total NNZ, density~0.025%
#   8 procs:  1.6M×1.6M matrix,   320M total NNZ, density~0.0125%
#  16 procs:  3.2M×3.2M matrix,   640M total NNZ, density~0.00625%
#  32 procs:  6.4M×6.4M matrix,  1.28B total NNZ, density~0.003125%
#

# Exit on error
set -e

# Load required modules
module load gcc91
module load mpich-3.2.1--gcc-9.1.0

# Navigate to project directory
echo "=== Weak Scaling Benchmark ==="
echo "Initial directory: $(pwd)"
cd PARCO-Computing-2026-244967/deliv_2/ 2>/dev/null || true

# Create results directory
mkdir -p results

# Remove old results file to start fresh
rm -f results/weak_scaling_results.csv

# Configuration
# Limit to 128 procs max - beyond this, communication overhead dominates
PROCESS_COUNTS=(2 4 8 16 32 64 128)
THREADS_PER_RANK=2
ITERATIONS=10

# Weak scaling parameters
# IMPORTANT: 200k rows/proc provides sufficient compute/comm ratio
# Previous 25k was too small - communication dominated (96%+ overhead)
# Target: compute time > 50ms per iteration for valid weak scaling
ROWS_PER_PROC=200000    # Each process handles 200k rows
NNZ_PER_PROC=40000000   # 40M NNZ per process (constant work per process)

# Set OpenMP environment
export OMP_NUM_THREADS=$THREADS_PER_RANK
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export OMP_STACKSIZE=64M

# Print job info
echo "=============================================="
echo "  Weak Scaling Benchmark"
echo "=============================================="
echo "Job ID: $PBS_JOBID"
echo "Started: $(date)"
echo "Nodes allocated: $(cat $PBS_NODEFILE | sort -u | wc -l)"
echo "Node list: $(cat $PBS_NODEFILE | sort -u | tr '\n' ' ')"
echo ""
echo "Configuration:"
echo "  Threads per MPI rank: $THREADS_PER_RANK"
echo "  Iterations per test: $ITERATIONS"
echo "  Rows per process: $ROWS_PER_PROC"
echo "  Target NNZ per process: $NNZ_PER_PROC (~40M)"
echo "  Process counts: ${PROCESS_COUNTS[*]}"
echo ""
echo "Weak Scaling Matrix Sizes (constant NNZ per process):"
for NP in "${PROCESS_COUNTS[@]}"; do
    TOTAL_ROWS=$((NP * ROWS_PER_PROC))
    TOTAL_NNZ=$((NP * NNZ_PER_PROC))
    echo "  $NP processes: ${TOTAL_ROWS}×${TOTAL_ROWS} matrix, ~$((TOTAL_NNZ / 1000000))M total NNZ"
done
echo ""

# Compile the benchmark
echo "Compiling test_weak_scaling.c..."
cd src
mpicc -std=c99 -g -Wall -O3 -fopenmp -o test_weak_scaling \
    test_weak_scaling.c generator.c m_to_csr.c -lm

if [ $? -ne 0 ]; then
    echo "ERROR: Compilation failed"
    exit 1
fi
echo "Compilation successful."
echo ""

cd ..

# Run benchmarks for each process count
for NP in "${PROCESS_COUNTS[@]}"; do
    TOTAL_ROWS=$((NP * ROWS_PER_PROC))
    TOTAL_NNZ=$((NP * NNZ_PER_PROC))
    TOTAL_THREADS=$((NP * THREADS_PER_RANK))
    
    echo "=============================================="
    echo "  Process Count: $NP"
    echo "  Matrix Size: $TOTAL_ROWS × $TOTAL_ROWS"
    echo "  Target Total NNZ: ~$((TOTAL_NNZ / 1000000))M"
    echo "  Total Threads: $TOTAL_THREADS"
    echo "=============================================="
    
    # Run the benchmark
    mpirun -np $NP \
        --bind-to none \
        ./src/test_weak_scaling $ROWS_PER_PROC $NNZ_PER_PROC $ITERATIONS
    
    if [ $? -eq 0 ]; then
        echo "Completed successfully"
    else
        echo "WARNING: Test with $NP processes failed"
    fi
    
    echo ""
done

echo ""
echo "=============================================="
echo "  Weak Scaling Benchmark Complete"
echo "=============================================="
echo "Finished: $(date)"
echo ""
echo "Results saved to: results/weak_scaling_results.csv"
echo ""
# Verify results file was created
if [ -f results/weak_scaling_results.csv ]; then
    echo "CSV file verified. Line count:"
    wc -l results/weak_scaling_results.csv
    echo ""
    echo "First few lines:"
    head -3 results/weak_scaling_results.csv
else
    echo "ERROR: CSV results file not found at results/weak_scaling_results.csv"
    exit 1
fi

echo "=============================================="