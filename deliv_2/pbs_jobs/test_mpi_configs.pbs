#!/bin/bash
#PBS -N test_mpi_configs
#PBS -o ./test_mpi_configs.out
#PBS -e ./test_mpi_configs.err
#PBS -q short_cpuQ
#PBS -l walltime=06:00:00
#PBS -l select=6:ncpus=48:mem=32gb

# Load modules
module load gcc91 openmpi41

# Navigate to project root directory
echo "Starting directory: $(pwd)"

# Find project root (handles submission from anywhere)
if [ -d "src" ]; then
    echo "Found src/ - already in project root"
elif [ -d "../src" ]; then
    cd ..
    echo "Moved up one directory to: $(pwd)"
elif [ -d "deliv_2/src" ]; then
    cd deliv_2
    echo "Changed to deliv_2 directory: $(pwd)"
elif [ -d "pbs_jobs" ]; then
    echo "In pbs_jobs/ directory, moving up"
    cd ..
else
    echo "ERROR: Cannot find project directory!"
    echo "Current location: $(pwd)"
    ls -la
    exit 1
fi

echo "Project root: $(pwd)"

# Load necessary modules
echo "Loading modules..."
module load gcc91
module load mpich-3.2.1--gcc-9.1.0


# Verify MPI setup
echo "=== MPI Environment ==="
which mpicc
which mpirun
mpicc --version
ompi_info --version

# Clean and recompile the MPI test executable
echo ""
echo "Cleaning old build artifacts..."
rm -f test_config_mpi *.o

echo "Compiling test_configurations_mpi executable..."
mpicc -g -Wall -O3 -fopenmp -c src/test_configurations_mpi.c -o test_configurations_mpi.o
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to compile test_configurations_mpi.c"
    exit 1
fi

gcc-9.1.0 -g -Wall -O3 -fopenmp -c src/generator.c -o generator.o
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to compile generator.c"
    exit 1
fi

gcc-9.1.0 -g -Wall -O3 -fopenmp -c src/m_to_csr.c -o m_to_csr.o
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to compile m_to_csr.c"
    exit 1
fi

mpicc -g -Wall -O3 -fopenmp -o test_config_mpi \
    test_configurations_mpi.o generator.o m_to_csr.o -lm
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to link test_config_mpi"
    exit 1
fi

if [ ! -x test_config_mpi ]; then
    echo "ERROR: test_config_mpi was not created or is not executable"
    exit 1
fi

echo "Successfully compiled test_config_mpi"
ls -lh test_config_mpi

echo ""
echo "=== Starting MPI Communication Configurations Benchmark ==="
echo "Timestamp: $(date)"
echo ""

# Run the benchmark orchestration script
bash scripts/bench_mpi_configurations.sh
BENCH_EXIT=$?

echo ""
echo "=== MPI Configurations benchmark completed ==="
echo "Benchmark script exit code: $BENCH_EXIT"
echo "Timestamp: $(date)"

exit $BENCH_EXIT
