#!/bin/bash
#PBS -N test_single
#PBS -o ./test_single.out
#PBS -e ./test_single.err
#PBS -q short_cpuQ
#PBS -l walltime=0:15:00
#PBS -l select=1:ncpus=24:mem=8gb

# Test a single matrix run to see what output is produced

# Load modules
module load gcc91

# Go to project directory
cd "$PBS_O_WORKDIR"
cd ..

echo "Working directory: $(pwd)"
echo "Testing single matrix with test_config_numa"
echo "=========================================="

# Make sure executable exists
if [ ! -f ./test_config_numa ]; then
    echo "Compiling test_config_numa..."
    gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/test_configurations_numa.c -o test_configurations_numa.o
    gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/generator.c -o generator.o
    gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/m_to_csr.c -o m_to_csr.o
    gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -o test_config_numa test_configurations_numa.o generator.o m_to_csr.o -lm
fi

echo ""
echo "Running: ./test_config_numa 24 2k_0p22.mtx 5"
echo "=========================================="
./test_config_numa 24 2k_0p22.mtx 5

echo ""
echo "=========================================="
echo "Test completed with exit code: $?"
