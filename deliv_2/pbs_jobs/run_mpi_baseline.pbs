#!/bin/bash
#PBS -N mpi_matrices_bench
#PBS -o ./mpi_matrices_bench.out
#PBS -e ./mpi_matrices_bench.err
#PBS -q short_cpuQ
#PBS -l walltime=4:00:00
#PBS -l select=2:ncpus=96:mem=32gb

# MPI Benchmarking: Test distributed SpMV across all matrices
# Uses 2 MPI ranks, 48 threads per rank
# Output: results/mpi_matrices_results.csv

echo "=== MPI SpMV Benchmark ==="
echo "Initial directory: $(pwd)"
cd PARCO-Computing-2026-244967/deliv_2/

# Navigate to deliv_2 directory (PBS starts in submission directory or home)
if [ -d "deliv_2" ]; then
    cd deliv_2
    echo "Changed to deliv_2/"
elif [ -d "../deliv_2" ]; then
    cd ../deliv_2
    echo "Changed to ../deliv_2/"
elif [ -d "." ] && [ -f "Makefile" ] && grep -q "mtrvec" Makefile; then
    echo "Already in deliv_2 directory"
else
    echo "ERROR: Cannot find deliv_2 directory!"
    echo "Current directory: $(pwd)"
    ls -la
    exit 1
fi

echo "Working directory: $(pwd)"

# Load necessary modules
echo "Loading modules..."
module load gcc91
module load mpich-3.2.1--gcc-9.1.0

# Verify MPI installation
echo "Verifying MPI installation..."
mpicc --version || { echo "mpicc not found!"; exit 1; }
mpirun --version || { echo "mpirun not found!"; exit 1; }

# Set up environment for make
export CC=mpicc
export CFLAGS="-O3 -Wall -Wextra -march=native -fopenmp"

# Print the name of the file that contains the list of the nodes assigned to the job and list all the nodes
NODES=$(cat $PBS_NODEFILE)
echo The running nodes are $NODES

# Get the list of unique nodes assigned to the job
NODES=$(sort -u $PBS_NODEFILE)
echo The running nodes are $NODES

# Compile the MPI code
echo "Compiling MPI code..."
make clean > /dev/null 2>&1
make > compile.log 2>&1
if [ ! -f "mtrvec" ]; then
    echo "ERROR: Compilation failed!"
    cat compile.log
    exit 1
fi
echo "Compilation successful: mtrvec executable created"

# Setup output files
OUTPUT_CSV="results/mpi_matrices_results.csv"
echo "DEBUG: Creating results directory..."
mkdir -p results
echo "DEBUG: Results directory created"

# Write CSV header
echo "DEBUG: Writing CSV header to $OUTPUT_CSV..."
echo "matrix,rows,cols,density_pct,nnz,threads_per_rank,omp_time_ms,mpi_time_ms,speedup" > "$OUTPUT_CSV"
echo "DEBUG: CSV header written. File size: $(wc -c < "$OUTPUT_CSV") bytes"
echo "CSV header written to $OUTPUT_CSV"

# Configuration
NUM_RANKS=2
THREADS_PER_RANK=48

echo ""
echo "DEBUG: About to show benchmark configuration"
echo "=== Benchmark Configuration ==="
echo "Number of MPI ranks: $NUM_RANKS"
echo "Threads per rank: $THREADS_PER_RANK"

echo "DEBUG: Checking matrices directory..."
ls -la matrices/ | head -5
echo "DEBUG: Counting matrices..."
MATRIX_COUNT=$(ls matrices/*.mtx 2>/dev/null | wc -l)
echo "Matrices: $MATRIX_COUNT files found"
echo ""

# Counter for progress
TOTAL_MATRICES=$(ls matrices/*.mtx 2>/dev/null | wc -l)
echo "DEBUG: TOTAL_MATRICES=$TOTAL_MATRICES"
CURRENT=0

echo "DEBUG: Starting matrix loop"

# Loop through all matrices
for matrix_file in matrices/*.mtx; do
    CURRENT=$((CURRENT + 1))
    matrix_basename=$(basename "$matrix_file")
    
    echo "[$CURRENT/$TOTAL_MATRICES] Processing: $matrix_basename"
    
    # Run the benchmark and capture output
    echo "DEBUG: Running: mpirun -np $NUM_RANKS ./mtrvec $THREADS_PER_RANK \"$matrix_file\""
    output=$(mpirun -np $NUM_RANKS ./mtrvec $THREADS_PER_RANK "$matrix_file" 2>&1)
    mpirun_exit=$?
    echo "DEBUG: mpirun exit code: $mpirun_exit"
    echo "DEBUG: output length: $(echo "$output" | wc -c) chars"
    
    if [ $mpirun_exit -ne 0 ]; then
        echo "DEBUG: mpirun failed with exit code $mpirun_exit"
        echo "DEBUG: Full output:"
        echo "$output"
        continue
    fi
    
    # Extract matrix details from output
    # Format: "Matrix loaded from file: matrices/121k_0p0093.mtx"
    # Format: "Matrix dimensions: 121500 rows × 121500 cols, 0.01% non-zero entries"
    
    echo "DEBUG: First 20 lines of output:"
    echo "$output" | head -20
    echo "DEBUG: ---"
    
    matrix_name=$(echo "$output" | grep "Matrix loaded from file" | awk '{print $NF}' | xargs basename)
    
    rows=$(echo "$output" | grep "Matrix dimensions:" | awk '{print $3}')
    cols=$(echo "$output" | grep "Matrix dimensions:" | awk '{print $6}')
    density=$(echo "$output" | grep "Matrix dimensions:" | awk '{print $9}' | sed 's/%//')
    
    # Extract the number of non-zeros from output
    # Parse nnz from the CSR output or calculate from density
    nnz=$(echo "$output" | grep -oP 'nnz.*?(?=\n)' | awk '{print $NF}' | head -1)
    if [ -z "$nnz" ]; then
        # If not found, calculate from density
        nnz=$(echo "scale=0; $rows * $cols * $density / 100" | bc)
    fi
    
    # Extract timing results
    omp_time=$(echo "$output" | grep "Average OpenMP execution time:" | awk '{print $NF}' | sed 's/milliseconds//')
    
    mpi_time=$(echo "$output" | grep "Average MPI+OpenMP execution time:" | awk '{print $NF}' | sed 's/milliseconds//')
    
    speedup=$(echo "$output" | grep "Speedup" | awk '{print $NF}' | sed 's/x$//')
    
    # Validate extracted values
    if [ -z "$rows" ] || [ -z "$omp_time" ] || [ -z "$mpi_time" ]; then
        echo "  DEBUG: Failed to parse output for $matrix_basename"
        echo "  DEBUG: Rows=$rows, OMP=$omp_time, MPI=$mpi_time"
        echo "  DEBUG: Full output was:"
        echo "$output"
        echo "  DEBUG: ---"
        continue
    fi
    
    # Append to CSV
    echo "$matrix_name,$rows,$cols,$density,$nnz,$THREADS_PER_RANK,$omp_time,$mpi_time,$speedup" >> "$OUTPUT_CSV"
    
    echo "  [OK] Results: OMP=${omp_time}ms, MPI=${mpi_time}ms, Speedup=${speedup}x"
done

echo ""
echo "=== Benchmark Complete ==="
echo "Results written to: $OUTPUT_CSV"
echo "Summary:"
wc -l "$OUTPUT_CSV"
echo ""
echo "First few results:"
head -5 "$OUTPUT_CSV"