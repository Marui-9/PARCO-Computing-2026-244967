#!/bin/bash
#PBS -N numa_bench
#PBS -o ./numa_bench.out
#PBS -e ./numa_bench.err
#PBS -q common_cpuQ
#PBS -l walltime=12:00:00
#PBS -l select=4:ncpus=24:mem=32gb

# Load modules
module load gcc91

# Navigate to project root directory
echo "Starting directory: $(pwd)"

# Find project root (handles submission from anywhere)
if [ -d "src" ]; then
    echo "Found src/ - already in project root"
elif [ -d "../src" ]; then
    cd ..
    echo "Moved up one directory to: $(pwd)"
elif [ -d "PARCO-Computing-2026-244967/src" ]; then
    cd PARCO-Computing-2026-244967
    echo "Changed to project directory: $(pwd)"
elif [ -d "pbs_jobs" ]; then
    echo "In pbs_jobs/ directory, moving up"
    cd ..
else
    echo "ERROR: Cannot find project directory!"
    echo "Current location: $(pwd)"
    ls -la
    exit 1
fi

echo "Project root: $(pwd)"

# Print system information
echo "========================================"
echo "NUMA Benchmark Job Started"
echo "========================================"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "Working directory: $(pwd)"
echo ""
echo "System Information:"
echo "CPUs available: $(nproc)"
echo ""

# Show NUMA topology if numactl is available
if command -v numactl &> /dev/null; then
    echo "NUMA topology:"
    numactl --hardware
    echo ""
fi

# Clean and recompile to ensure correct GLIBC version
echo "Cleaning old build artifacts..."
rm -f *.o executable test_config test_config_numa

# Compile the NUMA-aware executable
echo "Compiling NUMA-aware test_config_numa..."
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/test_configurations_numa.c -o test_configurations_numa.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/generator.c -o generator.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/m_to_csr.c -o m_to_csr.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -o test_config_numa test_configurations_numa.o generator.o m_to_csr.o -lm

if [ $? -ne 0 ]; then
    echo "ERROR: Compilation failed"
    exit 1
fi

echo "Compilation successful!"
ls -lh test_config_numa
echo ""

# Make benchmark script executable
chmod +x scripts/bench_configurations_numa.sh

# Run NUMA benchmark
echo "========================================"
echo "Starting NUMA-Aware Configuration Benchmark"
echo "========================================"
echo "Thread counts: 24-96"
echo "Expected duration: Several hours"
echo ""

bash scripts/bench_configurations_numa.sh

echo ""
echo "========================================"
echo "NUMA Benchmark Completed"
echo "========================================"
echo "Completed at: $(date)"
echo "Results: results/configurations_numa_results.csv"
echo "Log: results/configurations_numa_results.txt"
echo "========================================"
