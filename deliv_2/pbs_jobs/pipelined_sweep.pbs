#!/bin/bash
#PBS -N pipelined_sweep
#PBS -l select=8:ncpus=32:mpiprocs=16:ompthreads=2:mem=64gb
#PBS -l walltime=06:00:00
#PBS -q short_cpuQ
#PBS -o pipelined_sweep.out
#PBS -e pipelined_sweep.err
#PBS -m abe

#
# PBS Job: MPI Process Count Sweep for Pipelined SpMV Benchmark
#
# Resources requested:
#   - 8 nodes with 32 cores each (256 cores total, no hyperthreading)
#   - 16 MPI processes per node max (128 total)
#   - 2 OpenMP threads per MPI process
#   - 64GB memory per node
#
# With 8 nodes × 32 cores/node = 256 cores
# With 2 threads/process: supports up to 128 MPI processes
# Process counts tested: 2, 4, 8, 16, 32, 64, 128
#

# Exit on error
set -e

# Load required modules
module load gcc91
module load mpich-3.2.1--gcc-9.1.0

# Change to working directory
cd "$PBS_O_WORKDIR" || cd /home/jacob.marui/PARCO-Computing-2026-244967/deliv_2

# Create logs and results directories
mkdir -p logs
mkdir -p results

# Configuration
PROCESS_COUNTS=(2 4 8 16 32 64 128)
THREADS_PER_RANK=2
ITERATIONS=10

# Matrices to test (larger matrices for meaningful MPI scaling)
MATRICES=(
    "1438k_0p0016.mtx" 
     "1565k_0p0024.mtx"  
     "41292k_0p0001.mtx"  
     "916k_0p0006.mtx"
     "1508k_0p0012.mtx"  
     "2097k_0p0001.mtx"  
     "4848k_0p0003.mtx"
)

# Set OpenMP environment
export OMP_NUM_THREADS=$THREADS_PER_RANK
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export OMP_STACKSIZE=64M

# Print job info
echo "=============================================="
echo "  Pipelined MPI Sweep Benchmark"
echo "=============================================="
echo "Job ID: $PBS_JOBID"
echo "Started: $(date)"
echo "Nodes allocated: $(cat $PBS_NODEFILE | sort -u | wc -l)"
echo "Node list: $(cat $PBS_NODEFILE | sort -u | tr '\n' ' ')"
echo ""
echo "Configuration:"
echo "  Threads per MPI rank: $THREADS_PER_RANK"
echo "  Iterations per test: $ITERATIONS"
echo "  Process counts: ${PROCESS_COUNTS[*]}"
echo "  Matrices: ${#MATRICES[@]} total"
echo ""

# Compile the benchmark
echo "Compiling test_pipelined_mpi.c..."
cd src
mpicc -std=c99 -g -Wall -O3 -fopenmp -o test_pipelined_mpi \
    test_pipelined_mpi.c generator.c m_to_csr.c -lm

if [ $? -ne 0 ]; then
    echo "ERROR: Compilation failed"
    exit 1
fi
echo "Compilation successful."
echo ""

cd ..

# Run benchmarks for each matrix and process count
for MATRIX in "${MATRICES[@]}"; do
    MATRIX_BASENAME=$(basename "$MATRIX" .mtx)
    
    echo "=============================================="
    echo "  Matrix: $MATRIX"
    echo "=============================================="
    
    for NP in "${PROCESS_COUNTS[@]}"; do
        TOTAL_THREADS=$((NP * THREADS_PER_RANK))
        
        echo ""
        echo "----------------------------------------------"
        echo "Testing: $NP MPI ranks × $THREADS_PER_RANK threads = $TOTAL_THREADS total"
        echo "----------------------------------------------"
        
        # Run the benchmark
        mpirun -np $NP \
            --bind-to none \
            ./src/test_pipelined_mpi "$MATRIX" $ITERATIONS
        
        if [ $? -eq 0 ]; then
            echo "Completed successfully"
        else
            echo "WARNING: Test with $NP processes failed"
        fi
        
        echo ""
    done
done

echo ""
echo "=============================================="
echo "  Benchmark Complete"
echo "=============================================="
echo "Finished: $(date)"
echo ""
echo "Results saved to: results/pipelined_results.csv"
echo ""
