#!/bin/bash
#PBS -N test_pipelined_all
#PBS -o ./test_pipelined_all.out
#PBS -e ./test_pipelined_all.err
#PBS -q short_cpuQ
#PBS -l walltime=12:00:00
#PBS -l select=8:ncpus=24:mem=32gb

# Load necessary modules
echo "Loading modules..."
module load gcc91
module load mpich-3.2.1--gcc-9.1.0

# Navigate to project directory
echo "=== Pipelined MPI Communication Benchmark (2-8 NODES) ==="
echo "Initial directory: $(pwd)"
cd PARCO-Computing-2026-244967/deliv_2/ 2>/dev/null || true

# Navigate to deliv_2 directory
if [ -d "deliv_2" ]; then
    cd deliv_2
    echo "Changed to deliv_2/"
elif [ -d "../deliv_2" ]; then
    cd ../deliv_2
    echo "Changed to ../deliv_2/"
elif [ -d "." ] && [ -f "Makefile" ]; then
    echo "Already in deliv_2 directory"
else
    echo "ERROR: Cannot find deliv_2 directory!"
    echo "Current directory: $(pwd)"
    ls -la
    exit 1
fi

echo "Working directory: $(pwd)"

# Set OpenMP thread count (24 cores per node, 1 rank per node = 24 threads per rank)
# Adjust this if your cluster has different core counts
export OMP_NUM_THREADS=24
export OMP_PROC_BIND=close
export OMP_PLACES=cores
echo "OpenMP threads per rank: $OMP_NUM_THREADS"

# Verify MPI setup
echo "=== MPI Environment ==="
which mpicc
which mpirun
mpicc --version

# Clean and recompile the pipelined MPI test executable
echo ""
echo "=== Compiling test_pipelined_mpi ==="
if [ -f "test_pipelined_mpi" ]; then
    echo "Removing old executable..."
    rm -f test_pipelined_mpi
fi

mpicc -g -Wall -O3 -fopenmp -o test_pipelined_mpi \
    src/test_pipelined_mpi.c src/generator.c src/m_to_csr.c -lm

if [ ! -f "test_pipelined_mpi" ]; then
    echo "ERROR: Compilation failed!"
    exit 1
fi
chmod +x test_pipelined_mpi
echo "✓ Compilation successful"
echo "Executable: $(pwd)/test_pipelined_mpi"
echo ""

# Run the benchmark script
echo "=== Starting Benchmark Suite ==="
echo "Script: scripts/pipelined_tests/bench_pipelined_all_nodes.sh"
echo ""

# Make script executable and run it
chmod +x scripts/pipelined_tests/bench_pipelined_all_nodes.sh
bash scripts/pipelined_tests/bench_pipelined_all_nodes.sh

# Capture exit code
EXIT_CODE=$?

# Print summary
echo ""
echo "=== Job Summary ==="
echo "Job ID: $PBS_JOBID"
echo "Job name: $PBS_JOBNAME"
echo "Nodes allocated: $(cat $PBS_NODEFILE | sort -u | wc -l)"
echo "Exit code: $EXIT_CODE"
echo "Completed at: $(date)"

if [ $EXIT_CODE -eq 0 ]; then
    echo "✓ Benchmark completed successfully"
else
    echo "✗ Benchmark completed with errors (exit code: $EXIT_CODE)"
fi

exit $EXIT_CODE
