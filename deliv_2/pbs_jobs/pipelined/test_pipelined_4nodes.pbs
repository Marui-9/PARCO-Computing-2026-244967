#!/bin/bash
#PBS -N test_pipelined_4nodes
#PBS -o ./test_pipelined_4nodes.out
#PBS -e ./test_pipelined_4nodes.err
#PBS -q short_cpuQ
#PBS -l walltime=04:00:00
#PBS -l select=4:ncpus=48:mem=32gb

echo "Loading modules..."; module load gcc91; module load mpich-3.2.1--gcc-9.1.0
echo "=== Pipelined MPI Benchmark (4 NODES) ==="
cd PARCO-Computing-2026-244967/deliv_2/ 2>/dev/null || true
if [ -d "deliv_2" ]; then cd deliv_2; elif [ -d "../deliv_2" ]; then cd ../deliv_2; elif [ -f "Makefile" ]; then true; else echo "ERROR: Cannot find deliv_2"; exit 1; fi
export OMP_NUM_THREADS=48; export OMP_PROC_BIND=close; export OMP_PLACES=cores
echo "Working directory: $(pwd)"
echo "=== Compiling test_pipelined_mpi ==="; rm -f test_pipelined_mpi
mpicc -g -Wall -O3 -fopenmp -o test_pipelined_mpi src/test_pipelined_mpi.c src/generator.c src/m_to_csr.c -lm
if [ ! -f "test_pipelined_mpi" ]; then echo "ERROR: Compilation failed!"; exit 1; fi
chmod +x test_pipelined_mpi; echo "✓ Compilation successful"
echo "=== Starting Benchmark ==="; chmod +x scripts/pipelined_tests/bench_pipelined_4nodes.sh
bash scripts/pipelined_tests/bench_pipelined_4nodes.sh
EXIT_CODE=$?; echo ""; echo "Exit code: $EXIT_CODE"; echo "Completed at: $(date)"
exit $EXIT_CODE
