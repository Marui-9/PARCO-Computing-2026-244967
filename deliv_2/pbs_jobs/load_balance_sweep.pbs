#!/bin/bash
#PBS -N lb_sweep
#PBS -l select=8:ncpus=64:mpiprocs=16:ompthreads=4:mem=64gb
#PBS -l walltime=06:00:00
#PBS -q short_cpuQ
#PBS -o load_balance_sweep.out
#PBS -e load_balance_sweep.err
#PBS -m abe

#
# PBS Job: Load Balance Strategy Sweep for SpMV Benchmark
#
# Resources requested:
#   - 8 nodes with 64 cores each (512 cores total, no hyperthreading)
#   - 16 MPI processes per node max (128 total)
#   - 4 OpenMP threads per MPI process
#   - 64GB memory per node
#
# With 8 nodes × 64 cores/node = 512 cores
# With 4 threads/process: supports up to 128 MPI processes
# Process counts tested: 2, 4, 8, 16, 24, 32, 48, 64, 72, 84, 96, 108, 128
#

# Exit on error
set -e

# Load required modules
module load gcc91
module load mpich-3.2.1--gcc-9.1.0

# Navigate to project directory
echo "=== Load Balance Strategy Sweep Benchmark ==="
echo "Initial directory: $(pwd)"
cd PARCO-Computing-2026-244967/deliv_2/ 2>/dev/null || cd /home/jacob/Desktop/PARCO-Computing-2026-244967/deliv_2/ 2>/dev/null || true
echo "Working directory: $(pwd)"

# Create results directory
mkdir -p results

# Configuration
PROCESS_COUNTS=(2 4 8 16 32 64 128)
THREADS_PER_RANK=4
ITERATIONS=10

# Test matrices (larger matrices for meaningful MPI scaling)
MATRICES=(
    #"matrices/41292k_0p0001.mtx"  
    "matrices/916k_0p0006.mtx" 
    "matrices/1508k_0p0012.mtx"  
    "matrices/2097k_0p0001.mtx"  
   # "matrices/4848k_0p0003.mtx"
    "matrices/1438k_0p0016.mtx" 
    "matrices/1565k_0p0024.mtx" 
)

# Set OpenMP environment
export OMP_NUM_THREADS=$THREADS_PER_RANK
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export OMP_STACKSIZE=64M

# Print job info
echo "=============================================="
echo "  Load Balance Strategy Sweep Benchmark"
echo "=============================================="
echo "Job ID: $PBS_JOBID"
echo "Started: $(date)"
echo "Nodes allocated: $(cat $PBS_NODEFILE | sort -u | wc -l)"
echo "Node list: $(cat $PBS_NODEFILE | sort -u | tr '\n' ' ')"
echo ""
echo "Configuration:"
echo "  Threads per MPI rank: $THREADS_PER_RANK"
echo "  Iterations per test: $ITERATIONS"
echo "  Process counts: ${PROCESS_COUNTS[*]}"
echo "  Strategies: ROW-BASED, NNZ-BASED, HYBRID-0.5, HYBRID-0.7"
echo ""
echo "Matrices tested:"
for m in "${MATRICES[@]}"; do
    echo "  - $m"
done
echo ""

# Compile the benchmark
echo "Compiling test_load_balance_sweep.c..."
cd src
mpicc -std=c99 -g -Wall -O3 -fopenmp -o test_lb_sweep \
    test_load_balance_sweep.c load_balance.c generator.c m_to_csr.c -lm

if [ $? -ne 0 ]; then
    echo "ERROR: Compilation failed"
    exit 1
fi
echo "Compilation successful."
echo ""

cd ..

# Verify matrices exist before proceeding
echo "Verifying matrix files..."
MATRICES_FOUND=0
for m in "${MATRICES[@]}"; do
    if [ -f "$m" ]; then
        echo "  ✓ Found: $m"
        MATRICES_FOUND=$((MATRICES_FOUND + 1))
    else
        echo "  ✗ Missing: $m"
    fi
done

if [ "$MATRICES_FOUND" -eq 0 ]; then
    echo "ERROR: No matrices found! Check MATRICES array paths."
    exit 1
fi
echo ""

# Clear previous results
rm -f results/load_balance_results.csv

# Run benchmarks for each matrix and process count
for MATRIX in "${MATRICES[@]}"; do
    MATRIX_BASENAME=$(basename "$MATRIX" .mtx)
    
    # Check if matrix exists
    if [ ! -f "$MATRIX" ]; then
        echo "WARNING: Matrix not found: $MATRIX - skipping"
        continue
    fi
    
    echo "=============================================="
    echo "  Matrix: $MATRIX"
    echo "=============================================="
    
    for NP in "${PROCESS_COUNTS[@]}"; do
        TOTAL_THREADS=$((NP * THREADS_PER_RANK))
        
        echo ""
        echo "----------------------------------------------"
        echo "Testing: $NP MPI ranks × $THREADS_PER_RANK threads = $TOTAL_THREADS total"
        echo "----------------------------------------------"
        
        # Run the benchmark
        mpirun -np $NP \
            --bind-to none \
            ./src/test_lb_sweep "$MATRIX" $ITERATIONS
        
        if [ $? -eq 0 ]; then
            echo "Completed successfully"
        else
            echo "WARNING: Test with $NP processes failed"
        fi
        
        echo ""
    done
done

echo ""
echo "=============================================="
echo "  Benchmark Complete"
echo "=============================================="
echo "Finished: $(date)"
echo ""
echo "Results saved to: results/load_balance_results.csv"
echo ""
echo "Summary Statistics:"
echo "  Total matrices tested: ${#MATRICES[@]}"
echo "  Process counts: ${#PROCESS_COUNTS[@]}"
echo "  Strategies per test: 4 (ROW-BASED, NNZ-BASED, HYBRID-0.5, HYBRID-0.7)"
echo ""
echo "To analyze results:"
echo "  - View CSV: cat results/load_balance_results.csv"
echo "  - Count tests: wc -l results/load_balance_results.csv"
echo "  - Filter by strategy: grep NNZ-BASED results/load_balance_results.csv"
echo ""
