#!/bin/bash
#PBS -N benchmarks
#PBS -o ./benchmarks.out
#PBS -e ./benchmarks.err
#PBS -q short_cpuQ
#PBS -l walltime=4:00:00
#PBS -l select=1:ncpus=24:mem=10gb

# Load modules
module load gcc91
gcc() { gcc-9.1.0 "$@"; }
gcc --version

# Select the working directory
cd "$PBS_O_WORKDIR"

# Compile the project
gcc -O3 -Wall -Wextra -march=native -fopenmp -c main.c -o main.o
gcc -O3 -Wall -Wextra -march=native -fopenmp -c generator.c -o generator.o
gcc -O3 -Wall -Wextra -march=native -fopenmp -c m_to_csr.c -o m_to_csr.o
gcc -O3 -Wall -Wextra -march=native -fopenmp -o executable main.o generator.o m_to_csr.o -lm

# Compile test configurations
gcc -O3 -Wall -Wextra -march=native -fopenmp -c test_configurations.c -o test_configurations.o
gcc -O3 -Wall -Wextra -march=native -fopenmp -o test_config test_configurations.o generator.o m_to_csr.o -lm

echo "=== Starting Cache Benchmark ==="
bash bench_cache.sh

echo "=== Starting Configurations Benchmark ==="
bash bench_configurations.sh

echo "=== Starting Matrices Benchmark ==="
bash bench_matrices.sh

echo "=== All benchmarks completed ==="
