#!/ bin / bash
#PBS -N add_j 
#PBS -o ./array_addition.out 
#PBS -e ./array_addition.err 
#PBS -q short_cpuQ 
#PBS -l walltime=0:02:00 
#PBS -l select=1:ncpus=1:mem=1mb
# Load modules

module load gcc91
gcc() { gcc-9.1.0 "$@"; }
gcc --version
# Select the working directory
cd "$PBS_O_WORKDIR"
gcc array_addition.c -o arr_add
./arr_add