#!/bin/bash
#PBS -N cache_perf
#PBS -o ./cache_perf.out
#PBS -e ./cache_perf.err
#PBS -q short_cpuQ
#PBS -l walltime=2:00:00
#PBS -l select=1:ncpus=24:mem=16gb

# Cache benchmarking with perf stat
# Note: perf is much faster than valgrind and captures multi-threaded cache behavior

# Load modules
module load gcc91
gcc() { gcc-9.1.0 "$@"; }
gcc --version

# Verify perf is available
module load perf
echo "perf version:"
which perf
perf --version

# Navigate to project root directory
echo "Starting directory: $(pwd)"

# Find project root (handles submission from anywhere)
if [ -d "src" ]; then
    echo "Found src/ - already in project root"
elif [ -d "../src" ]; then
    cd ..
    echo "Moved up one directory to: $(pwd)"
elif [ -d "PARCO-Computing-2026-244967/src" ]; then
    cd PARCO-Computing-2026-244967
    echo "Changed to project directory: $(pwd)"
elif [ -d "pbs_jobs" ]; then
    echo "In pbs_jobs/ directory, moving up"
    cd ..
else
    echo "ERROR: Cannot find project directory!"
    echo "Current location: $(pwd)"
    ls -la
    exit 1
fi

echo "Project root: $(pwd)"

# Clean and recompile the project (to ensure correct GLIBC version)
echo "Cleaning old build artifacts..."
# Only remove our specific executable, not others that might be in use
rm -f cache_perf_*.o executable_cache_perf

echo "Compiling executable..."
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/main.c -o cache_perf_main.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/generator.c -o cache_perf_generator.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/m_to_csr.c -o cache_perf_m_to_csr.o
gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -o executable_cache_perf cache_perf_main.o cache_perf_generator.o cache_perf_m_to_csr.o -lm
echo "Compilation complete"

# Verify executable was created and is accessible
if [ ! -f executable_cache_perf ]; then
    echo "ERROR: executable not created!"
    exit 1
fi
ls -lh executable_cache_perf
chmod +x executable_cache_perf
echo "Executable verified and permissions set"

# Override EXECUTABLE variable for the benchmark script
export EXECUTABLE="./executable_cache_perf"

echo "========================================"
echo "Starting Cache Benchmark with perf stat"
echo "========================================"
echo "Started at: $(date)"
echo "Working directory: $(pwd)"
echo "Available matrices:"
ls -lh matrices/*.mtx
echo ""

# Run the perf cache benchmark
bash scripts/bench_cache_perf.sh

echo ""
echo "========================================"
echo "Cache perf Benchmark Completed"
echo "========================================"
echo "Completed at: $(date)"
echo "Results saved to: results/cache_perf_results.csv"
echo ""

# Display results summary if file exists
if [ -f results/cache_perf_results.csv ]; then
    echo "Total test runs:"
    wc -l < results/cache_perf_results.csv | awk '{print $1-1}'
    echo ""
    echo "First few results:"
    head -5 results/cache_perf_results.csv
fi
