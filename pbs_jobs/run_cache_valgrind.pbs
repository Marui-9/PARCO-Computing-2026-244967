#!/bin/bash
#PBS -N cache_valgrind
#PBS -o ./cache_valgrind.out
#PBS -e ./cache_valgrind.err
#PBS -q short_cpuQ
#PBS -l walltime=6:00:00
#PBS -l select=1:ncpus=24:mem=10gb

# Cache benchmarking with Valgrind Cachegrind
# Note: Valgrind adds significant overhead, so this takes longer than perf-based benchmarks

# Load modules
module load gcc91
gcc() { gcc-9.1.0 "$@"; }
gcc --version

# Verify valgrind is available (using system valgrind, no module needed)
echo "Valgrind version:"
which valgrind
valgrind --version

# Navigate to project root directory
echo "Starting directory: $(pwd)"

# Find project root (handles submission from anywhere)
if [ -d "src" ]; then
    echo "Found src/ - already in project root"
elif [ -d "../src" ]; then
    cd ..
    echo "Moved up one directory to: $(pwd)"
elif [ -d "PARCO-Computing-2026-244967/src" ]; then
    cd PARCO-Computing-2026-244967
    echo "Changed to project directory: $(pwd)"
elif [ -d "pbs_jobs" ]; then
    echo "In pbs_jobs/ directory, moving up"
    cd ..
else
    echo "ERROR: Cannot find project directory!"
    echo "Current location: $(pwd)"
    ls -la
    exit 1
fi

echo "Project root: $(pwd)"

# Compile the project (if not already compiled)
if [ ! -f executable ]; then
    echo "Compiling executable..."
    gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/main.c -o main.o
    gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/generator.c -o generator.o
    gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -c src/m_to_csr.c -o m_to_csr.o
    gcc-9.1.0 -O3 -Wall -Wextra -fopenmp -o executable main.o generator.o m_to_csr.o -lm
    echo "Compilation complete"
else
    echo "Using existing executable"
fi

echo "========================================"
echo "Starting Cache Benchmark with Valgrind"
echo "========================================"
echo "Started at: $(date)"
echo "Working directory: $(pwd)"
echo "Available matrices:"
ls -lh matrices/*.mtx
echo ""

# Run the valgrind cache benchmark
bash scripts/bench_cache_valgrind.sh

echo ""
echo "========================================"
echo "Cache Valgrind Benchmark Completed"
echo "========================================"
echo "Completed at: $(date)"
echo "Results saved to: results/cache_valgrind_results.csv"
echo ""

# Display results summary if file exists
if [ -f results/cache_valgrind_results.csv ]; then
    echo "Total test runs:"
    wc -l < results/cache_valgrind_results.csv | awk '{print $1-1}'
    echo ""
    echo "First few results:"
    head -5 results/cache_valgrind_results.csv
fi
